{
	"name": "@dvries/vite-use-intl-messages-declaration",
	"version": "0.1.0",
	"description": "Generate next-intl/use-intl message declaration files from JSON messages in Vite projects.",
	"packageManager": "pnpm@10.25.0",
	"type": "module",
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/vetledv/vite-use-intl-messages-declaration.git"
	},
	"bugs": {
		"url": "https://github.com/vetledv/vite-use-intl-messages-declaration/issues"
	},
	"homepage": "https://github.com/vetledv/vite-use-intl-messages-declaration#readme",
	"keywords": [
		"vite",
		"vite-plugin",
		"next-intl",
		"use-intl",
		"i18n",
		"typescript"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"vite": ">=7"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"typescript": "6.0.2",
		"vite": "8.0.8"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
